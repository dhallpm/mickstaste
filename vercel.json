{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/vip.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/vip",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/vip/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/premium.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/results.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/todays-picks.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/micks-admin.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/vip",
      "destination": "https://vip.mickspicks.us/",
      "permanent": true
    },
    {
      "source": "/vip/(.*)",
      "destination": "https://vip.mickspicks.us/",
      "permanent": true
    },
    {
      "source": "/premium.html",
      "destination": "https://vip.mickspicks.us/",
      "permanent": true
    },
    {
      "source": "/vip.html",
      "destination": "https://vip.mickspicks.us/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/vip-picks",
      "destination": "/api/todays-picks?vip=1"
    },
    {
      "source": "/api/website-feed",
      "destination": "/api/todays-picks"
    }
  ],
  "crons": [
    {
      "path": "/api/micks-admin",
      "schedule": "0 0 * * *"
    }
  ]
}
